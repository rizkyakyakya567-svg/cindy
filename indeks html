<section id="contact" style="text-align:center;border-top:1px solid var(--line)">
  <h2 class="reveal" style="font-size:clamp(48px,8vw,100px);line-height:.9">PUNYA IDE?<br><span style="color:var(--red);font-family:'Instrument Serif';text-transform:lowercase;font-style:italic">ayo wujudin.</span></h2>
  <div class="reveal" style="margin-top:40px"><a href="https://wa.me/6281234567890" class="btn-primary" style="padding:20px 50px;font-size:16px">CHAT WHATSAPP →</a></div>
</section>

<script>
// Loader
setTimeout(()=>document.getElementById('loader').classList.add('hide'),1200);

// Cursor
const c=document.querySelector('.cursor'), c2=document.querySelector('.cursor2');
document.addEventListener('mousemove', e=>{ c.style.left=e.clientX+'px'; c.style.top=e.clientY+'px'; c2.style.left=(e.clientX-20)+'px'; c2.style.top=(e.clientY-20)+'px'; });

// Navbar hide on scroll
let last=0; window.addEventListener('scroll',()=>{ const cur=scrollY; document.getElementById('navbar').classList.toggle('hide', cur>last && cur>200); last=cur; });

// Reveal
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in')}),{threshold:.15}); document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

// Tabs Biodata
function openTab(i){ document.querySelectorAll('.tab-content').forEach((t,idx)=>t.classList.toggle('active',idx===i)); document.querySelectorAll('.id-tabs button').forEach((b,idx)=>b.classList.toggle('active',idx===i)); }
</script>
</body>
</html>
