  <div class="id-wrap reveal in">
    <div class="id-card">
      <div class="id-tabs"><button class="active" onclick="openTab(0)">BIODATA</button><button onclick="openTab(1)">SKILL</button><button onclick="openTab(2)">FUN FACT</button></div>
      
      <div class="tab-content active" id="tab0">
        <div class="avatar-row"><div class="avatar"></div><div><div style="font-family:'Syne';font-weight:700">GANTI NAMA KAMU</div><div style="font-size:11px;color:var(--muted);letter-spacing:2px">CREATIVE DEV / 2026</div></div><div class="badge">● ONLINE</div></div>
        <div class="data">
          <div><b>UMUR</b><span>19 Tahun</span></div>
          <div><b>TTL</b><span>Bandung, 12 Jan 2005</span></div>
